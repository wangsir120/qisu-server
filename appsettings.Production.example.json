{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=QisuDB;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "Issuer": "qisu-server",
    "Audience": "qisu-client",
    "ExpirationMinutes": 1440
  },
  "Aliyun": {
    "AccessKeyId": "YOUR_ACCESS_KEY_ID",
    "AccessKeySecret": "YOUR_ACCESS_KEY_SECRET",
    "Sms": {
      "SignName": "YOUR_SIGN_NAME",
      "TemplateCode": "YOUR_TEMPLATE_CODE"
    }
  },
  "Juhe": {
    "IdCardKey": "YOUR_JUHE_API_KEY"
  },
  "Amap": {
    "WebApiKey": "YOUR_AMAP_API_KEY"
  }
}